# Azure Blob storage credentials for the coacervation platform.
# Copy this file to `.env` (same folder) and fill in real values.
# The `.env` file is git-ignored and must NEVER be committed.

# Full Azure Storage connection string (Account name + key or SAS).
AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOURACCOUNT;AccountKey=YOURKEY;EndpointSuffix=core.windows.net

# Container that holds CoacervationData.csv / CoacervationSamples.csv / CoacervationManifest.json
# Container names must be lowercase letters, numbers and hyphens only.
AZURE_BLOB_CONTAINER_NAME=coacervation-data

# Databricks / Nexus lookup (optional). A Personal Access Token enables server-side
# BatchID lookups without an interactive browser OAuth popup. Hostname / warehouse
# come from databricks_template.py.
DATABRICKS_ACCESS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Mintel GNPD product enrichment (optional). Config-driven so it works with your
# specific subscription with no code changes. The Mintel API host must also be
# allow-listed through the corporate (Zscaler) gateway for server-side access.
MINTEL_API_BASE=https://your-mintel-api-host
MINTEL_AUTH_MODE=bearer
MINTEL_API_KEY=your-mintel-api-key
MINTEL_AUTH_HEADER=Authorization
# OAuth2 client-credentials (only if MINTEL_AUTH_MODE=oauth2):
MINTEL_CLIENT_ID=
MINTEL_CLIENT_SECRET=
MINTEL_TOKEN_URL=
# Endpoint templates ({gtin} / {query} are substituted):
MINTEL_GTIN_ENDPOINT=/v1/products?gtin={gtin}
MINTEL_SEARCH_ENDPOINT=/v1/products?search={query}
# Response field paths (dot notation; first list element auto-picked):
MINTEL_RESULT_PATH=products
MINTEL_FIELD_NAME=product_name
MINTEL_FIELD_BRAND=brand
MINTEL_FIELD_INGREDIENTS=ingredients
MINTEL_FIELD_CLAIMS=claims
MINTEL_FIELD_IMAGE=image_url
